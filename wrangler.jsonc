{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aqarbooks",
  // Custom entry: the OpenNext fetch handler plus the Cron Trigger handler.
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Scheduled jobs (formerly GitHub Actions cron). Which /api/cron/* route each
  // expression runs is decided in lib/cron/schedule.ts. Times are UTC.
  "triggers": {
    "crons": ["* * * * *", "0,30 3,4 * * *"]
  }
}
