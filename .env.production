# Loaded automatically by `next build` (NODE_ENV=production) on every
# machine, unlike .env.local which is gitignored and per-developer. Not a
# secret -- this is the same public URL every generated invite/reminder
# link already exposes.
NEXT_PUBLIC_SITE_URL=https://aqarbooks.com

# Supabase's public client pair. These are inlined into the browser bundle by
# `next build` and are public by design -- the anon/publishable key is safe to
# expose and access is enforced by RLS, not by hiding it. They live here rather
# than only in .env.local because .env.local is gitignored, so the Cloudflare
# build had neither and silently fell back to placeholder values, which made
# every sign-in fail with "invalid email or password".
NEXT_PUBLIC_SUPABASE_URL=https://ataslxkcflxuilpgyepm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_csXU3cxFWCyaHrLGf9nW_g_0cf9UmBy
