-- LOAD VERIFY -- run in the rehearsal container, as supabase_admin, from the folder that holds data/, IMMEDIATELY after load.psql:
--   psql -U supabase_admin -d rh_base -v ON_ERROR_STOP=1 -f load-verify.psql
-- load.psql ran with session_replication_role = replica: foreign keys and user triggers were NOT enforced while loading (CHECK constraints and unique indexes were).
-- This script proves the loaded data is still a consistent database, and fails (non-zero exit) on the first class of violation it finds:
--   V0 neutralize references to schemas that were deliberately not exported (vault): referencing columns -> NULL; payment provider settings -> disabled
--   V1 row counts equal the counts taken in the export snapshot (data/_counts.csv)
--   V2 every foreign key of every public table has a parent (anti-join per constraint, all columns, MATCH SIMPLE like the database)
--   V3 every sequence owned by a public column is at or above the column's maximum
--   V4 constraints that are NOT VALID are listed (information)
--   V5 the migration ledger (supabase_migrations.schema_migrations: version + name) equals data/_ledger.csv exactly (no missing, no extra, same names)
--   V6 session_replication_role is back to its normal value ('origin') in a fresh session, is stored nowhere (database/role settings), and no trigger is disabled
--   V0 also writes v0-reference-changes.csv: one row per foreign key to an unexported schema, with the rows touched and the references actually removed
\set ON_ERROR_STOP on
set session_replication_role = replica;

\echo '== V0 references to schemas that were not exported'
create temp table rh_v0 (child text, columns text, parent_schema text, rows_touched bigint, references_removed bigint);
do $$
declare r record; n bigint; total bigint := 0; removed bigint;
begin
  for r in
    select con.conrelid::regclass::text as child,
           (select string_agg(format('%I = null', a.attname), ', ') from unnest(con.conkey) k join pg_attribute a on a.attrelid = con.conrelid and a.attnum = k) as sets,
           (select bool_and(not a.attnotnull) from unnest(con.conkey) k join pg_attribute a on a.attrelid = con.conrelid and a.attnum = k) as all_nullable,
           (select string_agg(a.attname, ',') from unnest(con.conkey) k join pg_attribute a on a.attrelid = con.conrelid and a.attnum = k) as cols,
           pn.nspname as parent_schema,
           (select string_agg(format('%I is not null', a.attname), ' and ') from unnest(con.conkey) k join pg_attribute a on a.attrelid = con.conrelid and a.attnum = k) as nn_filter
    from pg_constraint con
    join pg_class pc on pc.oid = con.confrelid
    join pg_namespace pn on pn.oid = pc.relnamespace
    where con.contype = 'f' and con.connamespace = 'public'::regnamespace and pn.nspname not in ('public', 'auth')
  loop
    if not r.all_nullable then
      raise exception 'V0: % (%) is NOT NULL but references schema % which was not exported', r.child, r.cols, r.parent_schema;
    end if;
    execute format('select count(*) from %s where %s', r.child, r.nn_filter) into removed;
    execute format('update %s set %s', r.child, r.sets);
    get diagnostics n = row_count;
    total := total + n;
    insert into rh_v0 values (r.child, r.cols, r.parent_schema, n, removed);
  end loop;
  raise notice 'V0: % row(s) touched (all rows of the referencing tables); % reference(s) actually removed', total, (select coalesce(sum(references_removed), 0) from rh_v0);
end $$;
do $$
declare was_enabled bigint;
begin
  if to_regclass('public.payment_provider_settings') is not null then
    select count(*) into was_enabled from public.payment_provider_settings where enabled or status = 'ENABLED';
    insert into rh_v0 select 'public.payment_provider_settings', 'enabled,status (set to false / DISABLED)', '(provider switch, not a reference)', count(*), was_enabled from public.payment_provider_settings;
    update public.payment_provider_settings set enabled = false, status = case when status = 'ENABLED' then 'DISABLED' else status end;
    raise notice 'V0: payment_provider_settings: % row(s), none enabled', (select count(*) from public.payment_provider_settings);
  end if;
end $$;

\echo '== V1 row counts against the export snapshot'
create temp table rh_expected (tbl text, n bigint);
\copy rh_expected from 'data/_counts.csv' with (format csv, header true)
do $$
declare r record; actual bigint; bad int := 0;
begin
  for r in select * from rh_expected order by tbl loop
    execute format('select count(*) from public.%I', r.tbl) into actual;
    if actual <> r.n then
      raise warning 'V1 COUNT MISMATCH %: expected %, loaded %', r.tbl, r.n, actual;
      bad := bad + 1;
    end if;
  end loop;
  if bad > 0 then raise exception 'V1: % table(s) with a different row count', bad; end if;
  raise notice 'V1: % tables, every row count matches', (select count(*) from rh_expected);
end $$;

\echo '== V2 foreign keys'
do $$
declare r record; q text; n bigint; bad int := 0; checked int := 0;
begin
  for r in
    select con.conname, con.conrelid::regclass::text as child, con.confrelid::regclass::text as parent,
      (select string_agg(format('c.%I is not null', ac.attname), ' and ' order by u.ord)
         from unnest(con.conkey) with ordinality u(k, ord) join pg_attribute ac on ac.attrelid = con.conrelid and ac.attnum = u.k) as not_null,
      (select string_agg(format('p.%I = c.%I', ap.attname, ac.attname), ' and ' order by u.ord)
         from unnest(con.conkey, con.confkey) with ordinality u(ck, pk, ord)
         join pg_attribute ac on ac.attrelid = con.conrelid and ac.attnum = u.ck
         join pg_attribute ap on ap.attrelid = con.confrelid and ap.attnum = u.pk) as joined
    from pg_constraint con
    where con.contype = 'f' and con.connamespace = 'public'::regnamespace
    order by con.conrelid::regclass::text, con.conname
  loop
    q := format('select count(*) from %s c where %s and not exists (select 1 from %s p where %s)', r.child, r.not_null, r.parent, r.joined);
    execute q into n;
    checked := checked + 1;
    if n > 0 then
      raise warning 'V2 ORPHANS: % (%) -> %: % row(s)', r.child, r.conname, r.parent, n;
      bad := bad + 1;
    end if;
  end loop;
  if bad > 0 then raise exception 'V2: % foreign key(s) with orphan rows (of % checked)', bad, checked; end if;
  raise notice 'V2: % foreign keys checked, no orphan row', checked;
end $$;

\echo '== V3 sequences'
do $$
declare r record; mx bigint; lv bigint; bad int := 0; checked int := 0;
begin
  for r in
    select s.oid::regclass::text as seq, t.oid::regclass::text as tbl, a.attname as col
    from pg_class s
    join pg_depend d on d.objid = s.oid and d.deptype in ('a', 'i')
    join pg_class t on t.oid = d.refobjid and t.relnamespace = 'public'::regnamespace
    join pg_attribute a on a.attrelid = t.oid and a.attnum = d.refobjsubid
    where s.relkind = 'S'
  loop
    execute format('select max(%I)::bigint from %s', r.col, r.tbl) into mx;
    lv := pg_sequence_last_value(r.seq::regclass);
    checked := checked + 1;
    if mx is not null and (lv is null or lv < mx) then
      raise warning 'V3 SEQUENCE BEHIND: % (last_value %) < max(%.%) = %', r.seq, lv, r.tbl, r.col, mx;
      bad := bad + 1;
    end if;
  end loop;
  if bad > 0 then raise exception 'V3: % sequence(s) behind their column (of % checked)', bad, checked; end if;
  raise notice 'V3: % owned sequences checked, none behind', checked;
end $$;

\echo '== V4 constraints that are NOT VALID (information)'
select conrelid::regclass::text || '.' || conname as not_valid_constraint from pg_constraint where not convalidated and connamespace = 'public'::regnamespace order by 1;

\echo '== V5 migration ledger'
create temp table rh_ledger_expected (version text, name text);
\copy rh_ledger_expected from 'data/_ledger.csv' with (format csv, header true, null '\N')
do $$
declare missing int; extra int; renamed int; total int;
begin
  if to_regclass('supabase_migrations.schema_migrations') is null then raise exception 'V5: supabase_migrations.schema_migrations does not exist'; end if;
  select count(*) into total from rh_ledger_expected;
  if total = 0 then raise exception 'V5: the exported ledger is empty'; end if;
  select count(*) into missing from rh_ledger_expected e where not exists (select 1 from supabase_migrations.schema_migrations m where m.version = e.version);
  select count(*) into extra from supabase_migrations.schema_migrations m where not exists (select 1 from rh_ledger_expected e where e.version = m.version);
  select count(*) into renamed from rh_ledger_expected e join supabase_migrations.schema_migrations m on m.version = e.version and m.name is distinct from e.name;
  if missing + extra + renamed > 0 then raise exception 'V5: ledger differs: % missing, % extra, % with a different name', missing, extra, renamed; end if;
  raise notice 'V5: ledger loaded and identical: % migrations (first %, last %)', total, (select min(version) from rh_ledger_expected), (select max(version) from rh_ledger_expected);
end $$;

\echo '== V6 session_replication_role'
reset session_replication_role;
do $$
declare v text := current_setting('session_replication_role'); stored int; disabled int;
begin
  if v <> 'origin' then raise exception 'V6: session_replication_role is % after reset (expected origin)', v; end if;
  select count(*) into stored from pg_db_role_setting s where exists (select 1 from unnest(s.setconfig) c where c like 'session_replication_role=%');
  if stored > 0 then raise exception 'V6: session_replication_role is stored in % database/role setting(s)', stored; end if;
  select count(*) into disabled from pg_trigger t join pg_class c on c.oid = t.tgrelid where not t.tgisinternal and t.tgenabled = 'D' and c.relnamespace in ('public'::regnamespace, 'auth'::regnamespace);
  if disabled > 0 then raise exception 'V6: % user trigger(s) are disabled', disabled; end if;
  raise notice 'V6: session_replication_role = origin, stored nowhere, no disabled user trigger';
end $$;

\copy (select * from rh_v0 order by child, columns) to 'v0-reference-changes.csv' with (format csv, header true)
\echo 'LOAD-VERIFY PASSED'
