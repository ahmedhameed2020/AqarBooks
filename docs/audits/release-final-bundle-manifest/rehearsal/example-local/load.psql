create temp table rh_seq (seq text, last_value bigint);
\copy rh_seq from 'data/_sequences.csv' with (format csv, header true, null '\N')
select setval(seq::regclass, last_value) from rh_seq;
create temp table rh_users (id uuid, created_at timestamptz, email text);
\copy rh_users from 'data/_auth_users.csv' with (format csv, header true, null '\N')
insert into auth.users (id, created_at, email, aud, role, instance_id) select id, created_at, email, 'authenticated', 'authenticated', '00000000-0000-0000-0000-000000000000' from rh_users on conflict do nothing;
create schema if not exists supabase_migrations;
create table if not exists supabase_migrations.schema_migrations (version text not null primary key, statements text[], name text);
create temp table rh_ledger (version text, name text);
\copy rh_ledger from 'data/_ledger.csv' with (format csv, header true, null '\N')
insert into supabase_migrations.schema_migrations (version, name) select version, name from rh_ledger on conflict (version) do nothing;
reset session_replication_role;
show session_replication_role;
analyze;
\echo LOAD DONE: now run load-verify.psql (relations, counts, sequences) before anything else
