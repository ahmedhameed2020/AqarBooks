\set ON_ERROR_STOP on
begin transaction isolation level repeatable read read only;
\copy (select code, name_ar, name_en, is_derived, sort_order, created_at from public.revenue_natures) to 'data/revenue_natures.csv' with (format csv, header true, null '\N')
\copy (select dedupe_key, organization_id, recipient_user_id, recipient_member_id, type, source_id, body_ar, body_en, action_url, status, attempts, next_attempt_at, created_at from public.gate_notification_outbox) to 'data/gate_notification_outbox.csv' with (format csv, header true, null '\N')
\copy (select id, access_event_id, organization_id, endpoint_id, gate_id, command_type, direction, adapter, status, attempts, case when claim_token is null then null else md5(ctid::text || 'claim_token')::uuid end as claim_token, claimed_at, next_attempt_at, result_code, created_at, updated_at from public.gate_hardware_commands) to 'data/gate_hardware_commands.csv' with (format csv, header true, null '\N')
\copy (select id, actor_id, organization_id, property_id, action, entity_type, entity_id, case when reason is null then null else 'x' || substr(md5(ctid::text || 'reason'), 1, 12) end as reason, case when safe_change_summary is null then null else (case jsonb_typeof(safe_change_summary::jsonb) when 'object' then (select coalesce(jsonb_object_agg(s.k, s.v) filter (where s.ok), '{}'::jsonb) || case when count(*) filter (where not s.ok) > 0 then jsonb_build_object('_redacted', count(*) filter (where not s.ok)) else '{}'::jsonb end from (select e.key as k, e.value as v, (jsonb_typeof(e.value) = 'null' or exists (select 1 from (values ('account_id','UUID'),('advance','NUM'),('advance_account_id','UUID'),('allocated','NUM'),('allocation_id','UUID'),('allowed_direction','ENUM:BOTH,ENTRY'),('amount','NUM'),('application_date','TS'),('applied_total','NUM'),('cashier_session_id','NUM'),('category_changed','BOOL'),('direction','ENUM:BOTH,ENTRY,EXIT'),('direction_mode','ENUM:BOTH'),('due_id','UUID'),('entry_number','NUM'),('expires_at','TS'),('explained_at','TS'),('explained_by','UUID'),('from','BOOL'),('gate_id','UUID'),('invitation_id','UUID'),('line_count','NUM'),('line_date','TS'),('linked_to_active_cashbox_or_bank','BOOL'),('member_id','UUID'),('new_status','ENUM:CLOSED,OPEN'),('payment_id','UUID'),('periods','NUM'),('previous_status','ENUM:SUBMITTED,TRIAGED'),('priority_changed','BOOL'),('provider','ENUM:FAWRY,PAYMOB'),('purchase_order_id','NUM'),('reason_code','ENUM:VALID_ENTRY,VALID_EXIT'),('reason_given','BOOL'),('receipt_number','NUM'),('remaining','NUM'),('remaining_after','NUM'),('reversal_date','TS'),('reversal_journal_entry_id','UUID'),('statement_id','UUID'),('status','ENUM:IN_PROGRESS,SUBMITTED,TRIAGED,active,suspended'),('to','BOOL'),('total','NUM'),('unit_id','UUID'),('usage_policy','ENUM:MULTI_USE,SINGLE_USE'),('valid_from','TS'),('valid_hours','NUM'),('valid_until','TS'),('visitor_invitation_id','UUID')) a(path, kind) where a.path = '' || e.key and case split_part(a.kind, ':', 1) when 'KEEP' then true when 'NUM' then jsonb_typeof(e.value) = 'number' when 'BOOL' then jsonb_typeof(e.value) = 'boolean' when 'UUID' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' when 'TS' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9:.]+(Z|[+-][0-9:]+)?)?$' when 'ENUM' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') = any (string_to_array(substr(a.kind, 6), ',')) else false end)) as ok from jsonb_each(safe_change_summary::jsonb) e) s) when 'array' then (select coalesce(jsonb_agg(case when jsonb_typeof(el.v) = 'object' then (select coalesce(jsonb_object_agg(s.k, s.v) filter (where s.ok), '{}'::jsonb) || case when count(*) filter (where not s.ok) > 0 then jsonb_build_object('_redacted', count(*) filter (where not s.ok)) else '{}'::jsonb end from (select e.key as k, e.value as v, (jsonb_typeof(e.value) = 'null' or exists (select 1 from (values ('account_id','UUID'),('advance','NUM'),('advance_account_id','UUID'),('allocated','NUM'),('allocation_id','UUID'),('allowed_direction','ENUM:BOTH,ENTRY'),('amount','NUM'),('application_date','TS'),('applied_total','NUM'),('cashier_session_id','NUM'),('category_changed','BOOL'),('direction','ENUM:BOTH,ENTRY,EXIT'),('direction_mode','ENUM:BOTH'),('due_id','UUID'),('entry_number','NUM'),('expires_at','TS'),('explained_at','TS'),('explained_by','UUID'),('from','BOOL'),('gate_id','UUID'),('invitation_id','UUID'),('line_count','NUM'),('line_date','TS'),('linked_to_active_cashbox_or_bank','BOOL'),('member_id','UUID'),('new_status','ENUM:CLOSED,OPEN'),('payment_id','UUID'),('periods','NUM'),('previous_status','ENUM:SUBMITTED,TRIAGED'),('priority_changed','BOOL'),('provider','ENUM:FAWRY,PAYMOB'),('purchase_order_id','NUM'),('reason_code','ENUM:VALID_ENTRY,VALID_EXIT'),('reason_given','BOOL'),('receipt_number','NUM'),('remaining','NUM'),('remaining_after','NUM'),('reversal_date','TS'),('reversal_journal_entry_id','UUID'),('statement_id','UUID'),('status','ENUM:IN_PROGRESS,SUBMITTED,TRIAGED,active,suspended'),('to','BOOL'),('total','NUM'),('unit_id','UUID'),('usage_policy','ENUM:MULTI_USE,SINGLE_USE'),('valid_from','TS'),('valid_hours','NUM'),('valid_until','TS'),('visitor_invitation_id','UUID')) a(path, kind) where a.path = '[].' || e.key and case split_part(a.kind, ':', 1) when 'KEEP' then true when 'NUM' then jsonb_typeof(e.value) = 'number' when 'BOOL' then jsonb_typeof(e.value) = 'boolean' when 'UUID' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' when 'TS' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9:.]+(Z|[+-][0-9:]+)?)?$' when 'ENUM' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') = any (string_to_array(substr(a.kind, 6), ',')) else false end)) as ok from jsonb_each(el.v) e) s) else '{}'::jsonb end order by el.o), '[]'::jsonb) from jsonb_array_elements(safe_change_summary::jsonb) with ordinality el(v, o)) else case when exists (select 1 from (values ('account_id','UUID'),('advance','NUM'),('advance_account_id','UUID'),('allocated','NUM'),('allocation_id','UUID'),('allowed_direction','ENUM:BOTH,ENTRY'),('amount','NUM'),('application_date','TS'),('applied_total','NUM'),('cashier_session_id','NUM'),('category_changed','BOOL'),('direction','ENUM:BOTH,ENTRY,EXIT'),('direction_mode','ENUM:BOTH'),('due_id','UUID'),('entry_number','NUM'),('expires_at','TS'),('explained_at','TS'),('explained_by','UUID'),('from','BOOL'),('gate_id','UUID'),('invitation_id','UUID'),('line_count','NUM'),('line_date','TS'),('linked_to_active_cashbox_or_bank','BOOL'),('member_id','UUID'),('new_status','ENUM:CLOSED,OPEN'),('payment_id','UUID'),('periods','NUM'),('previous_status','ENUM:SUBMITTED,TRIAGED'),('priority_changed','BOOL'),('provider','ENUM:FAWRY,PAYMOB'),('purchase_order_id','NUM'),('reason_code','ENUM:VALID_ENTRY,VALID_EXIT'),('reason_given','BOOL'),('receipt_number','NUM'),('remaining','NUM'),('remaining_after','NUM'),('reversal_date','TS'),('reversal_journal_entry_id','UUID'),('statement_id','UUID'),('status','ENUM:IN_PROGRESS,SUBMITTED,TRIAGED,active,suspended'),('to','BOOL'),('total','NUM'),('unit_id','UUID'),('usage_policy','ENUM:MULTI_USE,SINGLE_USE'),('valid_from','TS'),('valid_hours','NUM'),('valid_until','TS'),('visitor_invitation_id','UUID')) a(path, kind) where a.path = '.' and case split_part(a.kind, ':', 1) when 'KEEP' then true when 'NUM' then jsonb_typeof(safe_change_summary::jsonb) = 'number' when 'BOOL' then jsonb_typeof(safe_change_summary::jsonb) = 'boolean' when 'UUID' then jsonb_typeof(safe_change_summary::jsonb) = 'string' and (safe_change_summary::jsonb #>> '{}') ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' when 'TS' then jsonb_typeof(safe_change_summary::jsonb) = 'string' and (safe_change_summary::jsonb #>> '{}') ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9:.]+(Z|[+-][0-9:]+)?)?$' when 'ENUM' then jsonb_typeof(safe_change_summary::jsonb) = 'string' and (safe_change_summary::jsonb #>> '{}') = any (string_to_array(substr(a.kind, 6), ',')) else false end) then safe_change_summary::jsonb else '{}'::jsonb end end)::jsonb end as safe_change_summary, correlation_id, created_at from public.platform_audit_logs) to 'data/platform_audit_logs.csv' with (format csv, header true, null '\N')
\copy (select id, case when full_name is null then null else 'p' || substr(md5(ctid::text || 'full_name'), 1, 12) end as full_name, avatar_url, locale, created_at, updated_at from public.profiles) to 'data/profiles.csv' with (format csv, header true, null '\N')
\copy (select id, case when full_name is null then null else 'p' || substr(md5(ctid::text || 'full_name'), 1, 12) end as full_name, case when email is null then null else 'u' || substr(md5(ctid::text || 'email'), 1, 12) || '@example.invalid' end as email, case when phone is null then null else 'p' || substr(md5(ctid::text || 'phone'), 1, 12) end as phone, case when message is null then null else 'x' || substr(md5(ctid::text || 'message'), 1, 12) end as message, status, created_at from public.contact_requests) to 'data/contact_requests.csv' with (format csv, header true, null '\N')
\copy (select id, case when full_name is null then null else 'p' || substr(md5(ctid::text || 'full_name'), 1, 12) end as full_name, company, role_title, organization_name, units_count, gates_count, case when email is null then null else 'u' || substr(md5(ctid::text || 'email'), 1, 12) || '@example.invalid' end as email, case when phone is null then null else 'p' || substr(md5(ctid::text || 'phone'), 1, 12) end as phone, preferred_contact_method, case when message is null then null else 'x' || substr(md5(ctid::text || 'message'), 1, 12) end as message, status, created_at from public.demo_leads) to 'data/demo_leads.csv' with (format csv, header true, null '\N')
\copy (select id, cheque_id, from_status, to_status, changed_by, changed_at, case when note is null then null else 'x' || substr(md5(ctid::text || 'note'), 1, 12) end as note from public.cheque_status_history) to 'data/cheque_status_history.csv' with (format csv, header true, null '\N')
\copy (select id, journal_entry_id, line_number, account_id, case when description is null then null else 'x' || substr(md5(ctid::text || 'description'), 1, 12) end as description, debit, credit, cost_center_id, project_id from public.journal_entry_lines) to 'data/journal_entry_lines.csv' with (format csv, header true, null '\N')
\copy (select id, jurisdiction, revenue_nature, tax_treatment, vat_rate, effective_from, effective_to, e_document_type, issuer_scope, version, rule_hash, status, legal_reference, approved_by, approved_at, created_by, created_at from public.tax_rule_versions) to 'data/tax_rule_versions.csv' with (format csv, header true, null '\N')
\copy (select id, key, case when description is null then null else 'x' || substr(md5(ctid::text || 'description'), 1, 12) end as description from public.permissions) to 'data/permissions.csv' with (format csv, header true, null '\N')
\copy (select id, key, name_ar, name_en, sort_order, created_at from public.plans) to 'data/plans.csv' with (format csv, header true, null '\N')
\copy (select id, lease_id, event_type, amount, case when reason is null then null else 'x' || substr(md5(ctid::text || 'reason'), 1, 12) end as reason, created_by, created_at, event_date, journal_entry_id, settlement_account_id from public.unit_lease_deposit_events) to 'data/unit_lease_deposit_events.csv' with (format csv, header true, null '\N')
\copy (select id, name, slug, status, default_currency, created_at, updated_at, created_by, updated_by, entity_type, entity_type_custom_label, case when address is null then null else 'p' || substr(md5(ctid::text || 'address'), 1, 12) end as address, governorate, city, case when phone is null then null else 'p' || substr(md5(ctid::text || 'phone'), 1, 12) end as phone, case when email is null then null else 'u' || substr(md5(ctid::text || 'email'), 1, 12) || '@example.invalid' end as email, tax_id, tax_jurisdiction, tax_enforcement_enabled, tax_enforcement_enabled_at, tax_enforcement_enabled_by, tax_enforcement_disabled_at, tax_enforcement_disabled_by, tax_enforcement_disabled_reason, output_tax_account_id, input_tax_account_id, brand_color, logo_url, commercial_registry, tagline, fx_gain_account_id, fx_loss_account_id, asset_disposal_gain_account_id, asset_disposal_loss_account_id, is_demo from public.organizations) to 'data/organizations.csv' with (format csv, header true, null '\N')
\copy (select id, organization_id, bank_account_id, period_start, period_end, opening_balance, closing_balance, status, reconciled_at, reconciled_by, case when note is null then null else 'x' || substr(md5(ctid::text || 'note'), 1, 12) end as note, created_by, created_at, updated_at from public.bank_statements) to 'data/bank_statements.csv' with (format csv, header true, null '\N')
\copy (select id, organization_id, case when full_name is null then null else 'p' || substr(md5(ctid::text || 'full_name'), 1, 12) end as full_name, is_company, case when email is null then null else 'u' || substr(md5(ctid::text || 'email'), 1, 12) || '@example.invalid' end as email, case when phone is null then null else 'p' || substr(md5(ctid::text || 'phone'), 1, 12) end as phone, created_at, updated_at, created_by, user_id, customer_type, tax_registration_number, identity_document_type, identity_document_number, legal_name, country_code, case when billing_address is null then null else 'p' || substr(md5(ctid::text || 'billing_address'), 1, 12) end as billing_address, identity_verified_at, identity_verification_source, identity_verification_reference, archived_at, archived_by, archive_reason from public.members) to 'data/members.csv' with (format csv, header true, null '\N')
\copy (select id, organization_id, code, name_ar, name_en, unit_code, item_code_type, item_code, is_active, created_by, created_at, updated_at from public.catalogue_items) to 'data/catalogue_items.csv' with (format csv, header true, null '\N')
\copy (select id, organization_id, created_by, name, case when query is null then null else (case jsonb_typeof(query::jsonb) when 'object' then (select coalesce(jsonb_object_agg(s.k, s.v) filter (where s.ok), '{}'::jsonb) || case when count(*) filter (where not s.ok) > 0 then jsonb_build_object('_redacted', count(*) filter (where not s.ok)) else '{}'::jsonb end from (select e.key as k, e.value as v, (jsonb_typeof(e.value) = 'null' or exists (select 1 from (values (null::text,null::text)) a(path, kind) where a.path = '' || e.key and case split_part(a.kind, ':', 1) when 'KEEP' then true when 'NUM' then jsonb_typeof(e.value) = 'number' when 'BOOL' then jsonb_typeof(e.value) = 'boolean' when 'UUID' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' when 'TS' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9:.]+(Z|[+-][0-9:]+)?)?$' when 'ENUM' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') = any (string_to_array(substr(a.kind, 6), ',')) else false end)) as ok from jsonb_each(query::jsonb) e) s) when 'array' then (select coalesce(jsonb_agg(case when jsonb_typeof(el.v) = 'object' then (select coalesce(jsonb_object_agg(s.k, s.v) filter (where s.ok), '{}'::jsonb) || case when count(*) filter (where not s.ok) > 0 then jsonb_build_object('_redacted', count(*) filter (where not s.ok)) else '{}'::jsonb end from (select e.key as k, e.value as v, (jsonb_typeof(e.value) = 'null' or exists (select 1 from (values (null::text,null::text)) a(path, kind) where a.path = '[].' || e.key and case split_part(a.kind, ':', 1) when 'KEEP' then true when 'NUM' then jsonb_typeof(e.value) = 'number' when 'BOOL' then jsonb_typeof(e.value) = 'boolean' when 'UUID' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' when 'TS' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9:.]+(Z|[+-][0-9:]+)?)?$' when 'ENUM' then jsonb_typeof(e.value) = 'string' and (e.value #>> '{}') = any (string_to_array(substr(a.kind, 6), ',')) else false end)) as ok from jsonb_each(el.v) e) s) else '{}'::jsonb end order by el.o), '[]'::jsonb) from jsonb_array_elements(query::jsonb) with ordinality el(v, o)) else case when exists (select 1 from (values (null::text,null::text)) a(path, kind) where a.path = '.' and case split_part(a.kind, ':', 1) when 'KEEP' then true when 'NUM' then jsonb_typeof(query::jsonb) = 'number' when 'BOOL' then jsonb_typeof(query::jsonb) = 'boolean' when 'UUID' then jsonb_typeof(query::jsonb) = 'string' and (query::jsonb #>> '{}') ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' when 'TS' then jsonb_typeof(query::jsonb) = 'string' and (query::jsonb #>> '{}') ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9:.]+(Z|[+-][0-9:]+)?)?$' when 'ENUM' then jsonb_typeof(query::jsonb) = 'string' and (query::jsonb #>> '{}') = any (string_to_array(substr(a.kind, 6), ',')) else false end) then query::jsonb else '{}'::jsonb end end)::jsonb end as query, created_at from public.member_saved_filters) to 'data/member_saved_filters.csv' with (format csv, header true, null '\N')
