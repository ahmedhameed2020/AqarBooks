viewdef|effective_payment_allocations| SELECT pa.id, pa.payment_id, p.organization_id, p.property_id, pa.due_id, pa.amount, pa.applied_on, pa.kind, pa.journal_entry_id, pa.credit_account_id, pa.created_at FROM public.payment_allocations pa JOIN public.payments p ON p.id = pa.payment_id WHERE pa.reversed_at IS NULL AND p.status = 'POSTED'::text AND public.payment_receipt_entry_status(p.id) = 'POSTED'::text;
viewdef|gate_manual_exception_details| SELECT r.id, r.organization_id, r.gate_id, r.property_id, r.visitor_invitation_id, r.device_id, r.source_event_id, r.direction, r.outcome, r.category, r.reason, r.actor_user_id AS operator_user_id, r.occurred_at, a.id AS approval_id, a.actor_user_id AS supervisor_user_id, a.reason AS approval_reason, a.occurred_at AS approved_at, CASE WHEN a.id IS NULL THEN 'PENDING'::text ELSE 'APPROVED'::text END AS status FROM public.gate_manual_exceptions r LEFT JOIN public.gate_manual_exceptions a ON a.parent_exception_id = r.id WHERE r.record_type = 'REQUEST'::text;
viewdef|members_with_financials| SELECT m.id, m.organization_id, m.full_name, m.is_company, m.email, m.phone, COALESCE(ma.units_count, 0::bigint) AS units_count, COALESCE(ma.total_balance, 0::numeric)::numeric(19,4) AS total_balance, COALESCE(ma.total_balance, 0::numeric) > 0::numeric AS has_arrears, lp.last_payment_amount, lp.last_payment_date, m.user_id, m.archived_at FROM public.members m LEFT JOIN LATERAL ( SELECT count(*) AS units_count, sum(uwf.balance) AS total_balance FROM public.unit_ownerships ao JOIN public.units_with_financials uwf ON uwf.id = ao.unit_id WHERE ao.member_id = m.id AND (ao.end_date IS NULL OR ao.end_date >= CURRENT_DATE)) ma ON true LEFT JOIN LATERAL ( SELECT p.amount AS last_payment_amount, p.payment_date AS last_payment_date FROM public.payments p WHERE p.member_id = m.id AND p.status = 'POSTED'::text ORDER BY p.payment_date DESC, p.created_at DESC LIMIT 1) lp ON true;
viewdef|payment_credit_balances| SELECT p.id AS payment_id, p.organization_id, p.property_id, p.member_id, p.unit_id, p.payment_date, p.advance_amount, p.advance_account_id, COALESCE(ap.applied, 0::numeric)::numeric(19,4) AS applied_amount, (p.advance_amount - COALESCE(ap.applied, 0::numeric))::numeric(19,4) AS remaining_amount, (p.advance_amount - COALESCE(ap.applied, 0::numeric)) > 0::numeric AND NOT (EXISTS ( SELECT 1 FROM public.unit_ownerships uo WHERE uo.member_id = p.member_id AND uo.unit_id = p.unit_id AND (uo.start_date IS NULL OR uo.start_date <= CURRENT_DATE) AND (uo.end_date IS NULL OR uo.end_date >= CURRENT_DATE))) AS is_stranded FROM public.payments p LEFT JOIN LATERAL ( SELECT sum(e.amount) AS applied FROM public.effective_payment_allocations e WHERE e.payment_id = p.id AND e.kind = 'CREDIT_APPLICATION'::text) ap ON true WHERE p.status = 'POSTED'::text AND p.advance_amount > 0::numeric AND public.payment_receipt_entry_status(p.id) = 'POSTED'::text;
viewdef|resorts| SELECT id, organization_id, name, code, timezone, property_type, address, governorate, phone, email, created_at, updated_at, created_by, updated_by FROM public.properties;
viewdef|units_with_financials| SELECT u.id, u.organization_id, u.property_id, u.building_id, u.zone_id, u.code, u.unit_type, u.floor_number, u.area, u.is_active, b.name_ar AS building_name_ar, b.name_en AS building_name_en, z.name_ar AS zone_name_ar, z.name_en AS zone_name_en, co.owner_id, co.owner_name, CASE WHEN co.owner_id IS NOT NULL THEN 'OCCUPIED'::text ELSE 'VACANT'::text END AS occupancy_status, COALESCE(t.total_due, 0::numeric)::numeric(19,4) AS total_due, COALESCE(t.total_paid, 0::numeric)::numeric(19,4) AS total_paid, (COALESCE(t.total_due, 0::numeric) - COALESCE(t.total_paid, 0::numeric))::numeric(19,4) AS balance, (COALESCE(t.total_due, 0::numeric) - COALESCE(t.total_paid, 0::numeric)) > 0::numeric AS has_arrears, u.custom_type_label, co.owner_phone, u.archived_at FROM public.units u LEFT JOIN public.buildings b ON b.id = u.building_id LEFT JOIN public.zones z ON z.id = u.zone_id LEFT JOIN LATERAL ( SELECT sum(d.amount) FILTER (WHERE d.status <> 'VOID'::text) AS total_due, sum(x.paid) AS total_paid FROM public.dues d LEFT JOIN LATERAL ( SELECT sum(pa.amount) AS paid FROM public.effective_payment_allocations pa WHERE pa.due_id = d.id) x ON true WHERE d.unit_id = u.id) t ON true LEFT JOIN LATERAL ( SELECT uo.member_id AS owner_id, m.full_name AS owner_name, m.phone AS owner_phone FROM public.unit_ownerships uo JOIN public.members m ON m.id = uo.member_id WHERE uo.unit_id = u.id AND (uo.end_date IS NULL OR uo.end_date >= CURRENT_DATE) ORDER BY uo.is_primary_contact DESC, uo.share_percentage DESC, uo.start_date DESC LIMIT 1) co ON true;
